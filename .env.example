# Optional environment variables. Nothing here is required: the project uses
# no paid APIs, credentials or cloud services. Copy to .env only if needed.

# Point the dashboard at a different outputs / features folder (used by tests).
# ELECTRICITY_OUTPUTS_DIR=outputs
# ELECTRICITY_FEATURES_DIR=data/features

# Limit BLAS/OpenMP threads on small laptops (optional).
# OMP_NUM_THREADS=4
